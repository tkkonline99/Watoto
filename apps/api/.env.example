# Copy to .env for local development
NODE_ENV=development
PORT=3000

# Local docker-compose services (see docker-compose.yml at repo root)
DATABASE_URL=postgresql://watoto:watoto@localhost:5432/watoto?schema=public
REDIS_URL=redis://localhost:6379

# Dev-only JWT secret (production uses RS256 keys from AWS Secrets Manager)
JWT_SECRET=dev-secret-change-me
JWT_ACCESS_TTL=900

# Firebase Admin SDK service account JSON (base64) — leave empty to enable
# dev-token auth at POST /v1/auth/dev-token (development mode only)
FIREBASE_SA_B64=
