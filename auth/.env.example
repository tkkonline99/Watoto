# Copy this file to ".env" at your project root and fill in the values from
# Firebase console -> Project settings -> "Your apps" -> SDK setup and config.
#
# NOTE: Firebase client config is NOT secret. It identifies your project to
# Google; it does not grant access. Real protection comes from Security Rules
# and from your AWS backend verifying the ID token. Do not put admin/service
# keys here — those live only on your server.
#
# Expo exposes vars prefixed with EXPO_PUBLIC_ to the app at build time.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
