# Line endings for files a tool rewrites.
#
# core.autocrlf is true on the Windows machines this repo is worked on, so git
# checks files out with CRLF. Most of the toolchain writes LF: `flutter
# gen-l10n`, the content authoring scripts in content/, worklist.js, and the
# art manifest appender. The result was four generated l10n files (and, after
# any content run, the locale bundles and the library itself) permanently
# showing as modified with no content difference at all — noise in every
# `git status`, and a real risk of a genuine change hiding inside it.
#
# Pinning these paths to LF on both sides makes what the tools write match what
# git checked out. Everything else keeps the repo default.

# Generated by `flutter gen-l10n` on every build and test run.
apps/mobile/lib/l10n/gen/*.dart text eol=lf

# Written by content/extract_strings.py, build_locale.py and the stage authors.
apps/mobile/assets/i18n/*.json text eol=lf
content/i18n/*.json text eol=lf

# Written by content/author_stage*.py and deepen_stage7.py, both copies.
apps/mobile/assets/content/watoto_content_library.json text eol=lf
content/watoto_content_library.json text eol=lf

# Appended by the art-gap tooling before generate_art_batch.py runs.
content/production/images/*.csv text eol=lf

# Regenerated by `node content/worklist.js`.
docs/CONTENT_WORKLIST.md text eol=lf

# Binary — never touch these.
*.png binary
*.mp3 binary
*.wav binary
*.jks binary
*.keystore binary
